# ===============================
# Frontend Base URL
# ===============================
# URL where your frontend application is running
FRONTEND_BASE_URL=http://localhost:3000


# ===============================
# Server Configuration
# ===============================
# Port number on which backend server will run
PORT=8000


# ===============================
# Database Configuration
# ===============================
# MongoDB connection string
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>


# ===============================
# Authentication / Security
# ===============================
# Secret key used for JWT or other encryption
SECRET_KEY=your_secret_key_here


# ===============================
# Google OAuth Configuration
# ===============================
# Google Client ID for Google Login
GOOGLE_CLIENT_ID=your_google_client_id_here


# ===============================
# Email (SMTP) Configuration
# ===============================
# SMTP server host (example: Gmail)
EMAIL_HOST=smtp.gmail.com

# SMTP server port
EMAIL_PORT=587

# Email address used to send emails
EMAIL_USER=your_email@example.com

# App password or SMTP password for the email
EMAIL_PASS=your_email_app_password
